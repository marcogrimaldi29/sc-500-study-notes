---
import NoteLayout from '../../layouts/NoteLayout.astro';
import Callout from '../../components/Callout.astro';
import Mermaid from '../../components/Mermaid.astro';
import { SITE } from '../../data/site';
import { href } from '../../lib/urls';

const masterTree = `
flowchart TB
  Q["Read the requirement, then ask what it is really about"] --> A{"Is it about applying a control,<br/>or about knowing the state?"}

  A -->|"Applying<br/>a control"| CTRL{"What must the<br/>control govern?"}
  CTRL -->|"Who may act"| RBAC["Azure RBAC, or a<br/>Microsoft Entra role —<br/>PIM if it must be<br/>temporary or approved"]
  CTRL -->|"Its shape"| POL["Azure Policy<br/>Deny to prevent,<br/>DeployIfNotExists<br/>to remediate"]
  CTRL -->|"Reachability"| NET["Firewall rules, private<br/>endpoint, NSG, security<br/>admin rule, access<br/>restrictions"]
  CTRL -->|"Data at rest"| ENC["Encryption — TDE,<br/>customer-managed keys,<br/>Always Encrypted,<br/>disk encryption"]

  A -->|"Knowing<br/>the state"| KNOW{"Configuration,<br/>or live activity?"}
  KNOW -->|"Is the setup safe?"| CSPM["Defender for Cloud<br/>recommendations, secure<br/>score, compliance,<br/>attack paths"]
  KNOW -->|"Is something<br/>happening now?"| DET["A Defender workload<br/>protection plan, or a<br/>Microsoft Sentinel<br/>analytics rule"]
`;

const defenderTree = `
flowchart TB
  Q["A Defender feature is the answer — but which one?"] --> A{"What is being protected<br/>or examined?"}
  A -->|"Configuration risk,<br/>attack paths, secrets,<br/>exposed data"| CSPM["Defender CSPM plan"]
  A -->|"A specific resource<br/>type at runtime"| CWP{"Which resource type?"}
  A -->|"Internet-facing assets<br/>you may not know<br/>you own"| EASM["Defender External Attack<br/>Surface Management"]
  A -->|"Cross-product incidents,<br/>hunting, agents"| XDR["Microsoft Defender XDR,<br/>in the Defender portal"]
  CWP -->|"Windows and<br/>Linux machines"| SRV["Defender for Servers<br/>P1 for EDR, P2 for<br/>agentless, JIT and FIM"]
  CWP -->|"Blobs and files"| STO["Defender for Storage"]
  CWP -->|"SQL, MySQL,<br/>PostgreSQL, Cosmos"| DB["Defender for Databases"]
  CWP -->|"Kubernetes<br/>and registries"| CON["Defender for Containers"]
  CWP -->|"Generative AI<br/>workloads"| AI["Defender for AI Services"]
`;
---

<NoteLayout
  slug="exam-tips"
  description="SC-500 exam tips: key numbers, decision trees, the naming traps and commonly mistaken topics, a scenario-to-answer lookup table across all four skills, and a pre-exam checklist."
  intro="The final-week page. Numbers to memorise, boundaries that are constantly confused, traps that cost marks, and a way of reading questions that beats knowing one more feature."
  themeColor="#8a6200"
>
  <p class="lead">
    By this point you know the products. What separates a pass from a near-miss is <strong>discrimination</strong> —
    telling two similar controls apart quickly, under time pressure, when the question has been written specifically to
    make them look interchangeable. Everything below is organised around that.
  </p>

  <Callout type="note" title="Exam logistics">
    <p>
      <strong>120 minutes.</strong> <strong>700 out of 1000 to pass.</strong> Proctored, and it may include interactive
      components. Currently offered in English. You can retake 24 hours after a first failed attempt; later retakes have
      longer waits. At the time of writing there is <strong>no official practice assessment</strong> — check{' '}
      <a href={SITE.certPage} target="_blank" rel="noopener">the certification page</a> before you book, because it is
      expected within roughly eight weeks of the exam going generally available.
    </p>
  </Callout>

  <h2 id="how-to-read-a-question">How to read an SC-500 question</h2>
  <div class="card">
    <ol class="steps">
      <li>
        <strong>Find the requirement, then the constraint.</strong> Nearly every stem has both: "must be able to X"
        and "without Y" or "with the least administrative effort". The constraint is what separates the two plausible
        answers, so read it twice.
      </li>
      <li>
        <strong>Name the layer before you look at the options.</strong> Identity, network, resource configuration, data,
        posture or detection. Options from the wrong layer eliminate themselves.
      </li>
      <li>
        <strong>Check the scope words.</strong> "All current and future subscriptions" means management group. "Every
        database on the server, including new ones" means server-level. "One specific secret" means Azure RBAC on the
        secret.
      </li>
      <li>
        <strong>Prefer the answer that removes standing access or a public path.</strong> When two options both work,
        this is the tie-breaker the exam uses.
      </li>
      <li>
        <strong>On "minimise effort" questions, prefer the built-in.</strong> Built-in policy over custom policy,
        built-in role over custom role, content hub solution over hand-built rules, managed identity over anything you
        have to rotate.
      </li>
      <li>
        <strong>On ordering questions, say the order out loud before you drag.</strong> Report-only before on. Detection
        before Prevention. Audit before Deny. DNAT before network before application.
      </li>
    </ol>
  </div>

  <h2 id="master-decision-tree">The master decision tree</h2>
  <Mermaid code={masterTree} caption="Six questions, six families of answer. Placing the scenario here first is worth more than any individual fact below." />

  <h2 id="which-defender">Which Defender feature?</h2>
  <Mermaid code={defenderTree} caption="Defender is a brand across at least four products. Deciding which one is being asked about is half the battle on Skill 4 questions." />

