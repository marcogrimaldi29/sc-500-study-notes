---
import { PAGES } from '../data/site';
import { href } from '../lib/urls';

/**
 * Site-wide search.
 *
 * The index is built in the browser from the site's own rendered pages, section
 * by section, the first time search is opened. That means every term on every
 * page is searchable — prose, tables, callouts and code samples alike — without
 * a separate index to generate, commit and keep in step with the content. It
 * also behaves identically in `npm run dev` and in production, which a
 * build-time index would not.
 *
 * Results are section-level, so choosing one lands on the exact heading rather
 * than the top of a long page.
 */

const seed = PAGES.map((p) => ({
  url: href(p.slug),
  label: p.label,
  accent: p.accent,
}));
---

<button type="button" class="icon-btn search-btn" id="search-open" aria-label="Search the study notes" title="Search (Ctrl+K)">
  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d="M11.74 10.34a6 6 0 1 0-1.4 1.4l3.2 3.2a1 1 0 0 0 1.42-1.41l-3.21-3.2ZM7 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z" />
  </svg>
</button>

<dialog class="search-modal" id="search-modal" aria-label="Search the study notes">
  <div class="sm-inner">
    <div class="sm-field">
      <svg class="sm-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M11.74 10.34a6 6 0 1 0-1.4 1.4l3.2 3.2a1 1 0 0 0 1.42-1.41l-3.21-3.2ZM7 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z" />
      </svg>
      <input
        type="search"
        id="search-input"
        class="sm-input"
        placeholder="Search every page — services, caveats, SDK calls…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button type="button" class="sm-close" id="search-close" aria-label="Close search">Esc</button>
    </div>

    <p class="sm-status" id="search-status" role="status" aria-live="polite"></p>

    <ul class="sm-results" id="search-results" role="listbox" aria-label="Search results"></ul>

    <div class="sm-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</dialog>

<script type="application/json" id="search-pages" set:html={JSON.stringify(seed)} />

<script>
  interface Page {
    url: string;
    label: string;
    accent: string;
  }
  interface Record {
    url: string;
    label: string;
    accent: string;
    heading: string;
    hash: string;
    text: string;
    hay: string;
  }

  const openBtn = document.getElementById('search-open') as HTMLButtonElement | null;
  const modal = document.getElementById('search-modal') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('search-close');
  const list = document.getElementById('search-results') as HTMLUListElement | null;
  const status = document.getElementById('search-status');
  const seedEl = document.getElementById('search-pages');

  if (openBtn && modal && input && list && status && seedEl) {
    const pages: Page[] = JSON.parse(seedEl.textContent || '[]');

    let records: Record[] | null = null;
    let building: Promise<Record[]> | null = null;
    let active = -1;
    let hits: Record[] = [];

    const clean = (s: string) => s.replace(/\s+/g, ' ').trim();

    /* ---------- index ---------- */

    function extract(doc: Document, page: Page): Record[] {
      const out: Record[] = [];
      // Some terminology lives only in a diagram — "Reciprocal Rank Fusion" is
      // one — so diagrams have to be indexed. Keep the quoted labels (nodes,
      // edges, subgraph titles) and drop the graph syntax around them, which
      // would otherwise match on "flowchart" and arrow tokens.
      doc.querySelectorAll('pre.mermaid').forEach((node) => {
        const labels = (node.textContent || '').match(/"([^"]+)"/g) || [];
        node.textContent = labels.join(' ').replace(/<br\s*\/?>/g, ' ').replace(/"/g, ' ');
      });

      const root = doc.querySelector('.content');
      if (!root) return out;

      const push = (heading: string, hash: string, text: string) => {
        const t = clean(text);
        if (!t && !heading) return;
        out.push({
          url: page.url,
          label: page.label,
          accent: page.accent,
          heading: heading || page.label,
          hash,
          text: t,
          hay: (heading + ' ' + page.label + ' ' + t).toLowerCase(),
        });
      };

      // Everything above the first heading belongs to an intro record.
      const intro = doc.querySelector('.page-head p, .hero p');
      let heading = page.label;
      let hash = '';
      let buf = intro ? intro.textContent || '' : '';

      for (const node of Array.from(root.children)) {
        const tag = node.tagName;
        if (tag === 'H2' || tag === 'H3') {
          push(heading, hash, buf);
          heading = clean(node.textContent || '');
          hash = node.id ? '#' + node.id : '';
          buf = '';
        } else {
          buf += ' ' + (node.textContent || '');
        }
      }
      push(heading, hash, buf);
      return out;
    }

    function buildIndex(): Promise<Record[]> {
      if (records) return Promise.resolve(records);
      if (building) return building;

      building = Promise.all(
        pages.map((page) =>
          fetch(page.url)
            .then((r) => (r.ok ? r.text() : ''))
            .then((html) => (html ? extract(new DOMParser().parseFromString(html, 'text/html'), page) : []))
            .catch(() => [] as Record[]),
        ),
      ).then((groups) => {
        records = groups.flat();
        return records;
      });

      return building;
    }

    // Warm the index as soon as there is any sign of intent, so the first
    // keystroke has something to search.
    openBtn.addEventListener('pointerenter', () => void buildIndex(), { once: true });
    openBtn.addEventListener('focus', () => void buildIndex(), { once: true });

    /* ---------- scoring ---------- */

    function score(rec: Record, terms: string[], phrase: string): number {
      let s = 0;
      const heading = rec.heading.toLowerCase();
      const text = rec.text.toLowerCase();

      // Every term must appear somewhere, so multi-word queries narrow rather
      // than widen the result set.
      for (const term of terms) {
        if (!rec.hay.includes(term)) return 0;
        const word = new RegExp('\\b' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
        if (heading.includes(term)) s += word.test(heading) ? 12 : 8;
        if (rec.label.toLowerCase().includes(term)) s += 3;
        if (text.includes(term)) s += word.test(text) ? 3 : 1;
      }

      // An exact phrase is a much stronger signal than the same words scattered.
      if (terms.length > 1) {
        if (heading.includes(phrase)) s += 25;
        else if (text.includes(phrase)) s += 8;
      }
      // Prefer the tighter section when two cover the same ground.
      if (rec.text.length < 900) s += 1;
      return s;
    }

    /* ---------- rendering ---------- */

    function highlight(text: string, terms: string[]): DocumentFragment {
      const frag = document.createDocumentFragment();
      const lower = text.toLowerCase();
      const ranges: [number, number][] = [];

      for (const term of terms) {
        let i = lower.indexOf(term);
        while (i !== -1) {
          ranges.push([i, i + term.length]);
          i = lower.indexOf(term, i + term.length);
        }
      }
      ranges.sort((a, b) => a[0] - b[0]);

      let cursor = 0;
      for (const [start, end] of ranges) {
        if (start < cursor) continue;
        frag.append(text.slice(cursor, start));
        const mark = document.createElement('mark');
        mark.textContent = text.slice(start, end);
        frag.append(mark);
        cursor = end;
      }
      frag.append(text.slice(cursor));
      return frag;
    }

    function snippet(rec: Record, terms: string[]): string {
      const lower = rec.text.toLowerCase();
      let at = -1;
      for (const term of terms) {
        const i = lower.indexOf(term);
        if (i !== -1 && (at === -1 || i < at)) at = i;
      }
      if (at === -1) return rec.text.slice(0, 160) + (rec.text.length > 160 ? '…' : '');
      const start = Math.max(0, at - 70);
      const end = Math.min(rec.text.length, at + 130);
      return (start > 0 ? '…' : '') + rec.text.slice(start, end) + (end < rec.text.length ? '…' : '');
    }

    function setActive(next: number) {
      const items = Array.from(list!.querySelectorAll<HTMLLIElement>('.sm-hit'));
      if (!items.length) return;
      active = (next + items.length) % items.length;
      items.forEach((li, i) => {
        const on = i === active;
        li.classList.toggle('active', on);
        li.setAttribute('aria-selected', String(on));
        if (on) {
          li.scrollIntoView({ block: 'nearest' });
          input!.setAttribute('aria-activedescendant', li.id);
        }
      });
    }

    function render(query: string) {
      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      list!.innerHTML = '';
      active = -1;
      input!.removeAttribute('aria-activedescendant');

      if (!terms.length) {
        hits = [];
        status!.textContent = records ? 'Type to search every page.' : 'Type to search every page.';
        input!.setAttribute('aria-expanded', 'false');
        return;
      }
      if (!records) {
        status!.textContent = 'Building the index…';
        return;
      }

      const phrase = terms.join(' ');
      hits = records
        .map((rec) => ({ rec, s: score(rec, terms, phrase) }))
        .filter((r) => r.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 30)
        .map((r) => r.rec);

      input!.setAttribute('aria-expanded', String(hits.length > 0));
      status!.textContent = hits.length
        ? `${hits.length} result${hits.length === 1 ? '' : 's'}`
        : `No match for “${query}”.`;

      hits.forEach((rec, i) => {
        const li = document.createElement('li');
        li.className = 'sm-hit';
        li.id = `sm-hit-${i}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        li.style.setProperty('--accent', rec.accent);

        const a = document.createElement('a');
        a.href = rec.url + rec.hash;

        const crumb = document.createElement('span');
        crumb.className = 'sm-crumb';
        crumb.textContent = rec.label;

        const title = document.createElement('span');
        title.className = 'sm-title';
        title.append(highlight(rec.heading, terms));

        const body = document.createElement('span');
        body.className = 'sm-snippet';
        body.append(highlight(snippet(rec, terms), terms));

        a.append(crumb, title, body);
        li.append(a);
        list!.append(li);
      });

      if (hits.length) setActive(0);
    }

    /* ---------- open / close ---------- */

    async function open() {
      modal!.showModal();
      input!.value = '';
      render('');
      input!.focus();
      status!.textContent = 'Building the index…';
      await buildIndex();
      if (modal!.open) render(input!.value);
    }

    function close() {
      modal!.close();
    }

    openBtn.addEventListener('click', () => void open());
    closeBtn?.addEventListener('click', close);

    // Click outside the panel closes it; <dialog> handles Esc itself.
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    let debounce: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => render(input.value.trim()), 90);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter') {
        const link = list!.querySelector<HTMLAnchorElement>('.sm-hit.active a');
        if (link) {
          e.preventDefault();
          close();
          window.location.href = link.href;
        }
      }
    });

    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    // Ctrl/Cmd+K from anywhere, and "/" when not already typing.
    document.addEventListener('keydown', (e) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement)?.tagName || '');
      if ((e.key === 'k' || e.key === 'K') && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        modal.open ? close() : void open();
      } else if (e.key === '/' && !typing && !modal.open) {
        e.preventDefault();
        void open();
      }
    });
  }
</script>
