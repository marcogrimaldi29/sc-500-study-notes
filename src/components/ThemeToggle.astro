---
/**
 * Light / dark switcher drawn as the site's own brand mark.
 *
 * Dark mode shows the sunrise: a half disc resting on the horizon with three
 * rays, exactly like public/images/site-mark-no-bg.png. Clicking it lifts the
 * disc off the horizon, unclips it into a full circle and fans out the five
 * remaining rays, so light mode is a complete sun. All of that motion is CSS
 * (see the "Theme toggle" block in global.css) driven by html[data-theme].
 */
---

<button
  type="button"
  id="theme-toggle"
  class="icon-btn theme-toggle"
  aria-live="polite"
  title="Switch between light and dark"
>
  <span class="visually-hidden" data-theme-label>Switch theme</span>
  <svg class="sun-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <defs>
      <clipPath id="sunrise-clip">
        <!-- Height animates from the horizon line to the full box, turning
             the half dome into a complete disc. -->
        <rect class="clip-rect" x="0" y="0" width="24" />
      </clipPath>
    </defs>

    <!-- The whole ray group is tucked in close to the dome in the sunrise state
         and fans out to full radius for the sun. -->
    <g class="rays">
      <!-- The three rays the brand mark already has: they stay in both states. -->
      <line class="ray" x1="12" y1="2.2" x2="12" y2="4.9" />
      <line class="ray" x1="4.6" y1="5.3" x2="6.5" y2="7.2" />
      <line class="ray" x1="19.4" y1="5.3" x2="17.5" y2="7.2" />

      <!-- The five that only a full sun has. -->
      <line class="ray lower" x1="2.2" y1="12" x2="4.9" y2="12" />
      <line class="ray lower" x1="21.8" y1="12" x2="19.1" y2="12" />
      <line class="ray lower" x1="4.6" y1="18.7" x2="6.5" y2="16.8" />
      <line class="ray lower" x1="19.4" y1="18.7" x2="17.5" y2="16.8" />
      <line class="ray lower" x1="12" y1="21.8" x2="12" y2="19.1" />
    </g>

    <circle class="disc" cx="12" r="5.1" clip-path="url(#sunrise-clip)" />
    <line class="horizon" x1="3.2" y1="16.4" x2="20.8" y2="16.4" />
  </svg>
</button>

<script>
  const STORAGE_KEY = 'sc500-theme';

  function label(theme: string) {
    return theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
  }

  function apply(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      /* Private mode or blocked storage: the theme still applies for this page. */
    }
    document.querySelectorAll('[data-theme-label]').forEach((el) => {
      el.textContent = label(theme);
    });
    const btn = document.getElementById('theme-toggle');
    if (btn) btn.setAttribute('aria-label', label(theme));
    // Diagrams are rendered with theme-matched colours, so they need a repaint.
    window.dispatchEvent(new CustomEvent('sc500:themechange', { detail: { theme } }));
  }

  const btn = document.getElementById('theme-toggle');
  if (btn) {
    apply(document.documentElement.getAttribute('data-theme') || 'light');
    btn.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      apply(next);
    });
  }
</script>
